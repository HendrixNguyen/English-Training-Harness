# Copy to .env for `npm run dev`. All values are public (baked into the client).
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
# Empty: /settings hides the reminders switch (time can still be saved); set to the server's VAPID_PUBLIC_KEY to enable Web Push.
